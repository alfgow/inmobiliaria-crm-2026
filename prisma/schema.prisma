generator client {
  provider        = "prisma-client"
  output          = "../app/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["dbs14813645", "public"]
}

model api_keys {
  id           BigInt    @id(map: "idx_19222_primary") @default(autoincrement())
  user_id      Decimal   @db.Decimal
  name         String    @db.VarChar(255)
  prefix       String    @db.VarChar(12)
  key_hash     String    @unique(map: "idx_19222_api_keys_key_hash_unique") @db.VarChar(128)
  allowed_ip   String?   @db.VarChar(45)
  last_used_at DateTime? @db.Timestamptz(6)
  created_at   DateTime? @db.Timestamptz(6)
  updated_at   DateTime? @db.Timestamptz(6)

  @@index([user_id], map: "idx_19222_api_keys_user_id_foreign")
  @@schema("public")
}

model asesores {
  id         BigInt    @id(map: "idx_19230_primary") @default(autoincrement())
  nombre     String    @db.VarChar(255)
  email      String    @unique(map: "idx_19230_email") @db.VarChar(255)
  telefono   String?   @db.VarChar(50)
  created_at DateTime? @db.Timestamptz(6)
  updated_at DateTime? @db.Timestamptz(6)

  @@schema("public")
}

model blogs {
  id         BigInt    @id(map: "idx_19238_primary") @default(autoincrement())
  autor_id   Decimal   @db.Decimal
  titulo     String    @db.VarChar(200)
  slug       String    @unique(map: "idx_19238_slug") @db.VarChar(200)
  contenido  String
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @db.Timestamptz(6)

  @@index([autor_id], map: "idx_19238_autor_id")
  @@schema("public")
}

model codigos_postales {
  id               BigInt  @id(map: "idx_19270_primary") @default(autoincrement())
  d_codigo         String  @db.VarChar(5)
  d_asenta         String  @db.VarChar(255)
  d_tipo_asenta    String? @db.VarChar(100)
  d_mnpio          String? @db.VarChar(150)
  d_estado         String? @db.VarChar(150)
  d_ciudad         String  @db.VarChar(255)
  d_cp             String? @db.VarChar(10)
  c_estado         String? @db.VarChar(5)
  c_oficina        String? @db.VarChar(10)
  c_cp             String? @db.VarChar(10)
  c_tipo_asenta    String? @db.VarChar(5)
  c_mnpio          String? @db.VarChar(5)
  id_asenta_cpcons String? @db.VarChar(20)
  d_zona           String? @db.VarChar(20)
  c_cve_ciudad     String? @db.VarChar(10)

  @@schema("public")
}

model comentarios {
  id          BigInt    @id(map: "idx_19289_primary") @default(autoincrement())
  contacto_id Decimal   @db.Decimal
  comentario  String
  created_at  DateTime? @default(now()) @db.Timestamptz(6)

  @@index([contacto_id], map: "idx_19289_contacto_id")
  @@schema("public")
}

model contactos {
  id                       BigInt                     @id(map: "idx_19302_primary") @default(autoincrement())
  nombre                   String                     @db.VarChar(100)
  email                    String?                    @db.VarChar(150)
  telefono                 String                     @unique(map: "idx_19302_telefono") @db.VarChar(20)
  estado                   ContactStatus?             @default(nuevo)
  fuente                   String?                    @default("Web") @db.VarChar(50)
  created_at               DateTime?                  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime?                  @db.Timestamptz(6)
  contacto_conversaciones  contacto_conversaciones[]

  @@index([estado], map: "idx_contactos_estado")
  @@schema("public")
}

model contacto_conversaciones {
  id                BigInt            @id @default(autoincrement())
  contacto_id       BigInt
  wa_id             String            @unique(map: "contacto_conversaciones_wa_id_unique")
  inmueble_id       BigInt?
  canal             String            @default("whatsapp") @db.VarChar(30)
  estado_bot        String            @default("activo")
  iniciada_at       DateTime          @default(now()) @db.Timestamptz(6)
  ultimo_mensaje_at DateTime?         @db.Timestamptz(6)
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime          @default(now()) @db.Timestamptz(6)
  contactos             contactos               @relation(fields: [contacto_id], references: [id], onUpdate: NoAction, map: "contacto_conversaciones_contacto_fk")
  regina_contextos      regina_contextos        @relation(fields: [wa_id], references: [wa_id], onUpdate: NoAction, map: "contacto_conversaciones_contexto_fk")
  inmuebles             inmuebles?              @relation(fields: [inmueble_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "contacto_conversaciones_inmueble_fk")
  contacto_mensajes     contacto_mensajes[]

  @@index([contacto_id], map: "idx_contacto_conversaciones_contacto")
  @@index([estado_bot], map: "idx_contacto_conversaciones_estado_bot")
  @@index([inmueble_id], map: "idx_contacto_conversaciones_inmueble")
  @@schema("public")
}

model contacto_mensajes {
  id               BigInt                  @id @default(autoincrement())
  conversacion_id  BigInt
  message_id       String?                 @unique(map: "contacto_mensajes_message_id_unique")
  rol              String                  @db.VarChar(20)
  mensaje          String
  enviado_at       DateTime                @default(now()) @db.Timestamptz(6)
  created_at       DateTime                @default(now()) @db.Timestamptz(6)
  contacto_conversaciones contacto_conversaciones @relation(fields: [conversacion_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "contacto_mensajes_conversacion_fk")

  @@index([conversacion_id], map: "idx_contacto_mensajes_conversacion")
  @@index([enviado_at], map: "idx_contacto_mensajes_enviado_at")
  @@schema("public")
}

model error_logs {
  id              BigInt    @id(map: "idx_19311_primary") @default(autoincrement())
  exception_class String    @db.VarChar(255)
  message         String
  file            String?   @db.VarChar(512)
  line            BigInt?
  trace           String?
  status_code     Int?
  url             String?
  method          String?   @db.VarChar(20)
  payload         String?
  headers         String?
  user_id         Decimal?  @db.Decimal
  created_at      DateTime? @db.Timestamptz(6)
  updated_at      DateTime? @db.Timestamptz(6)

  @@index([user_id], map: "idx_19311_error_logs_user_id_foreign")
  @@schema("public")
}

model regina_contextos {
  wa_id                         String    @id
  nombre                        String?
  inmueble_id                   Int?
  status                        String?   @default("activo")
  rechazos_post                 Int?      @default(0)
  historial                     Json?     @default("[]")
  updated_at                    DateTime? @default(now()) @db.Timestamp(6)
  referencia_inmueble_pendiente String?
  resumen_contexto              Json?
  resumen_generado_at           DateTime? @db.Timestamptz(6)
  resumen_version               String?   @db.VarChar(30)
  contacto_conversaciones       contacto_conversaciones?

  @@schema("public")
}

model inmueble_estatus {
  id          Int         @id(map: "idx_19352_primary") @default(autoincrement())
  nombre      String      @unique(map: "idx_19352_nombre") @db.VarChar(50)
  descripcion String?     @db.VarChar(150)
  color       String?     @default("#ffffff") @db.VarChar(20)
  orden       BigInt?     @default(0)
  inmuebles   inmuebles[]

  @@schema("public")
}

model inmueble_imagenes {
  id          BigInt    @id(map: "idx_19360_primary") @default(autoincrement())
  disk        String    @default("s3") @db.VarChar(50)
  path        String?   @db.VarChar(255)
  url         String?   @db.VarChar(500)
  metadata    String?
  inmueble_id Decimal   @db.Decimal
  s3_key      String    @db.VarChar(255)
  orden       BigInt?   @default(0)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @db.Timestamptz(6)

  @@index([inmueble_id], map: "idx_19360_inmueble_id")
  @@schema("public")
}

model inmuebles {
  id                       BigInt              @id(map: "idx_19328_primary") @default(autoincrement())
  asesor_id                Decimal             @db.Decimal
  titulo                   String              @db.VarChar(200)
  slug                     String              @unique(map: "idx_19328_inmuebles_slug_unique") @db.VarChar(200)
  destacado                Boolean             @default(false)
  descripcion              String?
  precio                   Decimal             @db.Decimal(12, 2)
  direccion                String              @db.VarChar(255)
  latitud                  Decimal?            @db.Decimal(10, 6)
  longitud                 Decimal?            @db.Decimal(10, 6)
  colonia                  String?             @db.VarChar(255)
  municipio                String?             @db.VarChar(255)
  estado                   String?             @db.VarChar(150)
  codigo_postal            String?             @db.VarChar(10)
  tipo                     inmuebles_tipo
  operacion                inmuebles_operacion
  estatus_id               Int                 @default(1) @db.SmallInt
  habitaciones             Int?                @default(0) @db.SmallInt
  banos                    Int?                @default(0) @db.SmallInt
  estacionamientos         Int?                @default(0) @db.SmallInt
  metros_cuadrados         Decimal?            @default(0.00) @db.Decimal(10, 2)
  superficie_construida    Decimal?            @default(0.00) @db.Decimal(10, 2)
  superficie_terreno       Decimal?            @default(0.00) @db.Decimal(10, 2)
  anio_construccion        Int?
  video_url                String?             @db.VarChar(255)
  tour_virtual_url         String?             @db.VarChar(255)
  amenidades               String?
  extras                   String?
  tags                     String?
  created_at               DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at               DateTime?           @db.Timestamptz(6)
  requisitos_restricciones Json                @default("{\"requisitos\": [], \"restricciones\": []}")
  published_at             DateTime?           @db.Timestamptz(6)
  visible                  Boolean             @default(true)
  views                    Int                 @default(0)
  seo_description          String?
  banos_modalidad          String              @default("privado")
  inmueble_estatus         inmueble_estatus    @relation(fields: [estatus_id], references: [id], onUpdate: Restrict, map: "inmuebles_ibfk_2")
  contacto_conversaciones  contacto_conversaciones[]

  @@index([asesor_id], map: "idx_19328_asesor_id")
  @@index([estatus_id], map: "idx_19328_estatus_id")
  @@schema("public")
}

model interacciones_ia {
  id          BigInt    @id(map: "idx_19372_primary") @default(autoincrement())
  contacto_id Decimal   @db.Decimal
  payload     String
  created_at  DateTime? @default(now()) @db.Timestamptz(6)

  @@index([contacto_id], map: "idx_19372_contacto_id")
  @@schema("public")
}

model intereses {
  id          BigInt    @id(map: "idx_19380_primary") @default(autoincrement())
  contacto_id Decimal   @db.Decimal
  inmueble_id Decimal   @db.Decimal
  created_at  DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([contacto_id, inmueble_id], map: "idx_19380_contacto_inmueble_unique")
  @@index([inmueble_id], map: "idx_19380_inmueble_id")
  @@schema("public")
}

model restricciones_inmueble {
  id                             BigInt                                     @id(map: "idx_19414_primary") @default(autoincrement())
  id_inmueble                    Decimal                                    @db.Decimal
  acepta_mascotas                restricciones_inmueble_acepta_mascotas?    @default(no)
  acepta_ni_os                   restricciones_inmueble_acepta_ni_os?       @default(no) @map("acepta_niños")
  acepta_estudiantes             restricciones_inmueble_acepta_estudiantes? @default(no)
  acepta_roomies                 restricciones_inmueble_acepta_roomies?     @default(no)
  ingresos_minimos               Decimal?                                   @db.Decimal(10, 2)
  precio_poliza                  Decimal?                                   @db.Decimal(10, 2)
  requiere_comprobantes_ingresos Boolean?                                   @default(true)
  observaciones                  String?

  @@index([id_inmueble], map: "idx_19414_id_inmueble")
  @@schema("public")
}

model role_user {
  user_id Decimal @db.Decimal
  role_id Decimal @db.Decimal

  @@id([user_id, role_id], map: "idx_19432_primary")
  @@index([role_id], map: "idx_19432_role_id")
  @@schema("public")
}

model roles {
  id     BigInt @id(map: "idx_19428_primary") @default(autoincrement())
  nombre String @unique(map: "idx_19428_nombre") @db.VarChar(50)

  @@schema("public")
}

model users {
  id             BigInt    @id(map: "idx_19444_primary") @default(autoincrement())
  name           String    @db.VarChar(100)
  email          String    @unique(map: "idx_19444_email") @db.VarChar(150)
  role           String    @default("user") @db.VarChar(50)
  is_active      Boolean   @default(true)
  password       String    @db.VarChar(255)
  remember_token String?   @db.VarChar(100)
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  updated_at     DateTime? @updatedAt @db.Timestamptz(6)

  @@schema("public")
}

enum ContactStatus {
  nuevo
  en_contacto
  rejected
  blocked
  en_contacto_bot
  prospectando
  rechazado
  bloqueado

  @@map("contactos_estado")
  @@schema("dbs14813645")
}

enum inmuebles_operacion {
  Renta
  Venta

  @@schema("dbs14813645")
}

enum inmuebles_tipo {
  Departamento
  Casa
  Oficina
  Local_Comercial @map("Local Comercial")
  Terreno
  Bodega

  @@schema("dbs14813645")
}

enum restricciones_inmueble_acepta_estudiantes {
  si
  no

  @@schema("dbs14813645")
}

enum restricciones_inmueble_acepta_mascotas {
  si
  no
  solo_peque_as @map("solo pequeñas")

  @@schema("dbs14813645")
}

enum restricciones_inmueble_acepta_ni_os {
  si
  no

  @@map("restricciones_inmueble_acepta_niños")
  @@schema("dbs14813645")
}

enum restricciones_inmueble_acepta_roomies {
  si
  no
  max_2 @map("max 2")

  @@schema("dbs14813645")
}

enum contactos_estado {
  nuevo
  en_contacto
  rechazado
  bloqueado

  @@schema("public")
}
